# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=invoiceflow_db

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (leave blank for Development Simulation Mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=InvoiceFlow <no-reply@invoiceflow.local>

# Background Automation Scheduler (node-cron)
ENABLE_SCHEDULER=true
CRON_SCHEDULE=*/5 * * * *

